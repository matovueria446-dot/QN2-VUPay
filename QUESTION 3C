package ura.medicallogreader;

/**
 *
 * @author ADMIN
 */
import java.io.*;

public class MedicalLogReader {
    public static void main(String[] args) {
        File medicalLogFile = new File("medicalLog.txt");
        BufferedReader reader = null;

        try {
            reader = new BufferedReader(new FileReader(medicalLogFile));
            String line;
            System.out.println("--- Hospital Medical Log Content ---");
            while ((line = reader.readLine()) != null) {
                System.out.println(line);
            }
        } catch (FileNotFoundException e) {
            System.err.println("Error: The medical log file was not found.");
        } catch (IOException e) {
            System.err.println("Error: An issue occurred while reading the file.");
        } finally {
            try {
                if (reader != null) {
                    reader.close();
                    System.out.println("File stream closed successfully.");
                }
            } catch (IOException e) {
                System.err.println("Error closing the reader.");
            }
        }
    }
}
