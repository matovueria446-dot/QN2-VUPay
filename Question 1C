import java.util.Scanner;

public class VUCourses {
    public static void main(String[] args) {
    
        String moduleCode;
        String moduleName = "";
        int tuition = 0;
        boolean isValid = true;

        
        try (Scanner input = new Scanner(System.in)) {
            System.out.println("--- Victoria University VUPay System ---");
            System.out.print("Please enter the Module Code: ");
            moduleCode = input.nextLine().toUpperCase(); 
            
            
            switch (moduleCode) {
                case "BSF" -> {
                    moduleName = "BSc. Software Engineering";
                    tuition = 900000;
                }
                case "BIT" -> {
                    moduleName = "BSc. Information Technology";
                    tuition = 750000;
                }
                case "BCS" -> {
                    moduleName = "BSc. Computer Science";
                    tuition = 800000;
                }
                case "BCE" -> {
                    moduleName = "BSc. Computer Engineering";
                    tuition = 950000;
                }
                default -> isValid = false;
            }
            
            
            if (isValid) {
                System.out.println("\n--- Course Details ---");
                System.out.println("Module Name: " + moduleName);
                System.out.println("Tuition Fee: UGX " + tuition);
            } else {
                System.out.println("\nWrong Module Code details");
            }
        }
    }
}
